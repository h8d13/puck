[submodule "pacman"]
	path = pacman
	url = https://gitlab.archlinux.org/pacman/pacman.git
	ignore = untracked
[submodule "pacman-packaging"]
	path = pacman-packaging
	url = https://gitlab.archlinux.org/archlinux/packaging/packages/pacman.git
	ignore = untracked
[submodule "alpm"]
	path = alpm
	url = https://gitlab.archlinux.org/archlinux/alpm/alpm.git
[submodule "consumers/pyalpm"]
	path = consumers/pyalpm
	url = https://gitlab.archlinux.org/archlinux/pyalpm.git
[submodule "consumers/alpm.rs"]
	path = consumers/alpm.rs
	url = https://gitlab.archlinux.org/archlinux/alpm.rs.git
[submodule "consumers/go-alpm"]
	path = consumers/go-alpm
	url = https://github.com/Jguer/go-alpm.git
