@@ -0,0 +1,391 @@
+//! Reading of PKGINFO data the way pacman reads it.
+//!
+//! pacman reads the `.PKGINFO` file of a package with `parse_descfile` (`be_package.c`).
+//! [`PacmanPackageInfo`] follows that reader, so that the data can be seen the way pacman sees
+//! it, with the values parsed into ALPM types.
+//!
+//! In contrast to [`PackageInfo`][crate::PackageInfo], this is a reader for existing data and
+//! does not validate it against the [PKGINFO] specification.
+//!
+//! [PKGINFO]: https://alpm.archlinux.page/specifications/PKGINFO.5.html
+
+use std::str::FromStr;
+
+use alpm_types::{
+    Architecture,
+    Backup,
+    BuildDate,
+    ExtraDataEntry,
+    FullVersion,
+    Group,
+    License,
+    Name,
+    OptionalDependency,
+    PackageDescription,
+    PackageRelation,
+    Packager,
+    RelationOrSoname,
+    Url,
+};
+
+use crate::Error;
+
+/// PKGINFO data as pacman reads it.
+///
+/// Single keys are [`None`] if not set, list keys keep the order of their lines.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct PacmanPackageInfo {
+    /// The name of the package (`pkgname`).
+    pub pkgname: Option<Name>,
+    /// The base name of the package (`pkgbase`).
+    pub pkgbase: Option<Name>,
+    /// The version of the package (`pkgver`).
+    pub pkgver: Option<FullVersion>,
+    /// The description of the package (`pkgdesc`).
+    pub pkgdesc: Option<PackageDescription>,
+    /// The URL of the package (`url`).
+    pub url: Option<Url>,
+    /// The build date of the package (`builddate`).
+    ///
+    /// Read like pacman's `_alpm_parsedate`: a decimal number, `0` for anything else.
+    pub builddate: Option<BuildDate>,
+    /// The packager of the package (`packager`).
+    pub packager: Option<Packager>,
+    /// The installed size of the package (`size`).
+    ///
+    /// Read like pacman's `_alpm_strtoofft` into an `off_t`: a bare decimal number, `-1` for
+    /// anything else or a number past [`u64`], and numbers past [`i64::MAX`] wrap.
+    pub size: Option<i64>,
+    /// The architecture of the package (`arch`).
+    pub arch: Option<Architecture>,
+    /// The licenses of the package (`license`).
+    pub license: Vec<License>,
+    /// The groups of the package (`group`).
+    pub group: Vec<Group>,
+    /// The packages this package replaces (`replaces`).
+    pub replaces: Vec<PackageRelation>,
+    /// The packages this package conflicts with (`conflict`).
+    pub conflict: Vec<PackageRelation>,
+    /// The packages this package provides (`provides`).
+    pub provides: Vec<RelationOrSoname>,
+    /// The backup files of the package (`backup`).
+    pub backup: Vec<Backup>,
+    /// The dependencies of the package (`depend`).
+    pub depend: Vec<RelationOrSoname>,
+    /// The optional dependencies of the package (`optdepend`).
+    pub optdepend: Vec<OptionalDependency>,
+    /// The packages required to build this package (`makedepend`).
+    pub makedepend: Vec<PackageRelation>,
+    /// The packages this package is checked with (`checkdepend`).
+    pub checkdepend: Vec<PackageRelation>,
+    /// The extra data of the package (`xdata`), split at the first `=`.
+    pub xdata: Vec<ExtraDataEntry>,
+}
+
+/// Parses `value` into `T`.
+fn parse<T>(value: &str) -> Result<T, Error>
+where
+    T: FromStr,
+    Error: From<T::Err>,
+{
+    Ok(T::from_str(value)?)
+}
+
+/// Reads a decimal number like C's `strtoll`/`strtoull`: leading whitespace, an optional sign,
+/// digits. Returns the absolute value (saturated), whether it is negative and whether the whole
+/// string was read.
+fn strtonum(value: &str) -> Option<(u64, bool, bool)> {
+    let rest = value.trim_start_matches([' ', '\t', '\n', '\x0b', '\x0c', '\r']);
+    let (negative, rest) = match rest.as_bytes().first() {
+        Some(b'-') => (true, &rest[1..]),
+        Some(b'+') => (false, &rest[1..]),
+        _ => (false, rest),
+    };
+    let digits = rest.bytes().take_while(u8::is_ascii_digit).count();
+    if digits == 0 {
+        return None;
+    }
+    let number = rest[..digits].parse::<u64>().unwrap_or(u64::MAX);
+    Some((number, negative, digits == rest.len()))
+}
+
+/// pacman's `_alpm_parsedate`: `strtoll`, `0` for junk or a number past [`i64`].
+fn parsedate(value: &str) -> BuildDate {
+    match strtonum(value) {
+        Some((number, false, true)) => i64::try_from(number).unwrap_or(0),
+        Some((number, true, true)) if number <= i64::MIN.unsigned_abs() => {
+            0i64.wrapping_sub_unsigned(number)
+        }
+        _ => 0,
+    }
+}
+
+/// pacman's `_alpm_strtoofft`: a bare `strtoull` number cast to `off_t`, `-1` for anything
+/// else.
+fn strtoofft(value: &str) -> i64 {
+    if !value.starts_with(|c: char| c.is_ascii_digit()) {
+        return -1;
+    }
+    match value.parse::<u64>() {
+        // off_t of the unsigned long long, as the C casts it
+        Ok(number) => number as i64,
+        Err(_) => -1,
+    }
+}
+
+/// Sets a single key, which may only be set once.
+fn set_once<T>(field: &mut Option<T>, key: &str, value: T) -> Result<(), Error> {
+    if field.is_some() {
+        return Err(Error::DuplicateKey(key.to_string()));
+    }
+    *field = Some(value);
+    Ok(())
+}
+
+impl PacmanPackageInfo {
+    /// Reads one `key = value` line.
+    fn read(&mut self, key: &str, value: &str) -> Result<(), Error> {
+        match key {
+            "pkgname" => set_once(&mut self.pkgname, key, parse(value)?)?,
+            "pkgbase" => set_once(&mut self.pkgbase, key, parse(value)?)?,
+            "pkgver" => set_once(&mut self.pkgver, key, parse(value)?)?,
+            // Not used by pacman.
+            "basever" => {}
+            "pkgdesc" => {
+                let Ok(desc) = PackageDescription::from_str(value);
+                set_once(&mut self.pkgdesc, key, desc)?
+            }
+            "group" => self.group.push(value.to_string()),
+            "url" => set_once(&mut self.url, key, parse(value)?)?,
+            "license" => self.license.push(parse(value)?),
+            "builddate" => set_once(&mut self.builddate, key, parsedate(value))?,
+            "packager" => set_once(&mut self.packager, key, parse(value)?)?,
+            "arch" => set_once(&mut self.arch, key, parse(value)?)?,
+            "size" => set_once(&mut self.size, key, strtoofft(value))?,
+            "depend" => self.depend.push(parse(value)?),
+            "optdepend" => self.optdepend.push(parse(value)?),
+            "makedepend" => self.makedepend.push(parse(value)?),
+            "checkdepend" => self.checkdepend.push(parse(value)?),
+            "conflict" => self.conflict.push(parse(value)?),
+            "replaces" => self.replaces.push(parse(value)?),
+            "provides" => self.provides.push(parse(value)?),
+            "backup" => self.backup.push(parse(value)?),
+            "xdata" => {
+                let Some((name, value)) = value.split_once('=') else {
+                    return Err(Error::ExtraDataEmpty);
+                };
+                if self.xdata.is_empty() && name != "pkgtype" {
+                    return Err(Error::FirstExtraDataNotPkgType);
+                }
+                self.xdata
+                    .push(ExtraDataEntry::new(name.to_string(), value.to_string()));
+            }
+            _ => return Err(Error::UnknownKey(key.to_string())),
+        }
+        Ok(())
+    }
+
+    /// Ensures that the keys the [PKGINFO] specification requires are set.
+    ///
+    /// [PKGINFO]: https://alpm.archlinux.page/specifications/PKGINFO.5.html
+    fn ensure_required(&self) -> Result<(), Error> {
+        for (key, set) in [
+            ("pkgname", self.pkgname.is_some()),
+            ("pkgbase", self.pkgbase.is_some()),
+            ("pkgver", self.pkgver.is_some()),
+            ("pkgdesc", self.pkgdesc.is_some()),
+            ("url", self.url.is_some()),
+            ("builddate", self.builddate.is_some()),
+            ("packager", self.packager.is_some()),
+            ("size", self.size.is_some()),
+            ("arch", self.arch.is_some()),
+        ] {
+            if !set {
+                return Err(Error::MissingKey(key.to_string()));
+            }
+        }
+        Ok(())
+    }
+
+    /// Parses PKGINFO data like pacman's `parse_descfile`.
+    ///
+    /// Lines are `key = value`: the key ends at the first space, which must start ` = `, the
+    /// value is the rest of the line. Empty lines, lines starting with `#` and lines without
+    /// ` = ` after the key (e.g. with leading whitespace) are skipped.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use alpm_pkginfo::pacman::PacmanPackageInfo;
+    ///
+    /// # fn main() -> Result<(), alpm_pkginfo::Error> {
+    /// let data = b"pkgname = example
+    /// pkgbase = example
+    /// pkgver = 1:1.0.0-1
+    /// pkgdesc = A project that does something
+    /// url = https://example.org/
+    /// builddate = 1729181726
+    /// packager = John Doe <john@example.org>
+    /// size = 181849963
+    /// arch = any
+    ///   group = skipped
+    /// ";
+    /// let pkginfo = PacmanPackageInfo::parse(data)?;
+    /// assert_eq!(pkginfo.size, Some(181849963));
+    /// assert!(pkginfo.group.is_empty());
+    /// # Ok(())
+    /// # }
+    /// ```
+    ///
+    /// # Errors
+    ///
+    /// Returns an error if
+    /// - a value is not valid UTF-8 or cannot be parsed into its ALPM type,
+    /// - a key is unknown,
+    /// - a single key is set twice,
+    /// - an `xdata` value has no `=` or the first one is not `pkgtype`,
+    /// - or a key the [PKGINFO] specification requires is not set.
+    ///
+    /// [PKGINFO]: https://alpm.archlinux.page/specifications/PKGINFO.5.html
+    pub fn parse(data: &[u8]) -> Result<Self, Error> {
+        let mut pkginfo = Self::default();
+        for line in data.split(|&b| b == b'\n') {
+            // The C reads the line as a C string.
+            let line = line.split(|&b| b == 0).next().unwrap_or_default();
+            if line.is_empty() || line[0] == b'#' {
+                continue;
+            }
+            let Some(space) = line.iter().position(|&b| b == b' ') else {
+                continue;
+            };
+            let Some(value) = line[space..].strip_prefix(b" = ") else {
+                continue;
+            };
+            let key = String::from_utf8(line[..space].to_vec())?;
+            let value = String::from_utf8(value.to_vec())?;
+            pkginfo.read(&key, &value)?;
+        }
+        pkginfo.ensure_required()?;
+        Ok(pkginfo)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use rstest::rstest;
+    use testresult::TestResult;
+
+    use super::*;
+
+    const PKGINFO: &str = "\
+# Generated by makepkg
+pkgname = foo
+pkgbase = foo
+xdata = pkgtype=pkg
+pkgver = 1.0-1
+pkgdesc = a package
+url = https://example.org/
+builddate = 1720811171
+packager = John Doe <john@example.org>
+size = 2358
+arch = x86_64
+license = MIT
+depend = bar>=1.0
+";
+
+    /// Returns [`PKGINFO`] with `line` added.
+    fn with(line: &str) -> String {
+        format!("{PKGINFO}{line}\n")
+    }
+
+    /// Ensures that the fields are read.
+    #[test]
+    fn fields() -> TestResult {
+        let pkginfo = PacmanPackageInfo::parse(PKGINFO.as_bytes())?;
+        assert_eq!(pkginfo.pkgname, Some(Name::new("foo")?));
+        assert_eq!(pkginfo.builddate, Some(1720811171));
+        assert_eq!(pkginfo.size, Some(2358));
+        assert_eq!(pkginfo.depend.len(), 1);
+        assert_eq!(pkginfo.xdata[0].key(), "pkgtype");
+        Ok(())
+    }
+
+    /// Ensures that lines pacman skips are skipped.
+    #[rstest]
+    #[case::indented("  group = x")]
+    #[case::no_spaces("group=x")]
+    #[case::no_value("garbage")]
+    #[case::comment("# group = x")]
+    #[case::empty("")]
+    fn skipped_lines(#[case] line: &str) -> TestResult {
+        let pkginfo = PacmanPackageInfo::parse(with(line).as_bytes())?;
+        assert!(pkginfo.group.is_empty());
+        Ok(())
+    }
+
+    /// Ensures that values are read like pacman reads them.
+    #[rstest]
+    #[case::xdata_raw("xdata = a = b ", "a ", " b ")]
+    #[case::xdata_empty_value("xdata = a=", "a", "")]
+    fn xdata(#[case] line: &str, #[case] key: &str, #[case] value: &str) -> TestResult {
+        let pkginfo = PacmanPackageInfo::parse(with(line).as_bytes())?;
+        assert_eq!(
+            (pkginfo.xdata[1].key(), pkginfo.xdata[1].value()),
+            (key, value)
+        );
+        Ok(())
+    }
+
+    /// Ensures that numbers are read like pacman's `_alpm_parsedate` and `_alpm_strtoofft`.
+    #[rstest]
+    #[case::date_sign("+5", 5)]
+    #[case::date_negative("-5", -5)]
+    #[case::date_space(" 7", 7)]
+    #[case::date_junk("5x", 0)]
+    #[case::date_past_i64("9223372036854775808", 0)]
+    fn builddate(#[case] value: &str, #[case] expected: i64) -> TestResult {
+        let data = PKGINFO.replace("builddate = 1720811171", &format!("builddate = {value}"));
+        assert_eq!(
+            PacmanPackageInfo::parse(data.as_bytes())?.builddate,
+            Some(expected)
+        );
+        Ok(())
+    }
+
+    /// Ensures that the size is read like pacman's `_alpm_strtoofft`.
+    #[rstest]
+    #[case::sign("+5", -1)]
+    #[case::junk("5x", -1)]
+    #[case::wraps("18446744073709551615", -1)]
+    #[case::past_u64("18446744073709551616", -1)]
+    #[case::past_i64("9223372036854775808", i64::MIN)]
+    fn size(#[case] value: &str, #[case] expected: i64) -> TestResult {
+        let data = PKGINFO.replace("size = 2358", &format!("size = {value}"));
+        assert_eq!(
+            PacmanPackageInfo::parse(data.as_bytes())?.size,
+            Some(expected)
+        );
+        Ok(())
+    }
+
+    /// Ensures that invalid data fails.
+    #[rstest]
+    #[case::bad_value("depend = a>=")]
+    #[case::xdata_without_eq("xdata = ab")]
+    fn invalid(#[case] line: &str) {
+        assert!(PacmanPackageInfo::parse(with(line).as_bytes()).is_err());
+    }
+
+    /// Ensures that what the [PKGINFO] specification refuses fails.
+    ///
+    /// [PKGINFO]: https://alpm.archlinux.page/specifications/PKGINFO.5.html
+    #[rstest]
+    #[case::unknown_key(with("foo = bar"))]
+    #[case::duplicate_key(with("pkgdesc = second"))]
+    #[case::missing_key(PKGINFO.replace("url = https://example.org/\n", ""))]
+    #[case::pkgtype_not_first(PKGINFO.replace("pkgtype=pkg", "a=b"))]
+    #[case::empty_url(PKGINFO.replace("url = https://example.org/", "url = "))]
+    fn refused(#[case] data: String) {
+        assert!(PacmanPackageInfo::parse(data.as_bytes()).is_err());
+    }
+}
