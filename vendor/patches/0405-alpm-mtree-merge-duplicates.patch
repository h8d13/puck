+    /// Ensures that lines of the same path make one entry, where later keywords win.
+    #[test]
+    fn duplicate_paths() -> TestResult {
+        let data = mtree(&format!(
+            "{}{}./a time=5.0\n./\\141 uid=3 type=dir\n",
