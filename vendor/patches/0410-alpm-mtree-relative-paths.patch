+    /// Ensures that relative paths are read below the directory of the lines before.
+    #[test]
+    fn relative_paths() -> TestResult {
+        let data = "#mtree\n/set type=dir\nusr\n./x type=file\nbin\n..\nlib type=file\n\
+            ..\n..\nz\n";
+        let paths: Vec<PathBuf> = parse(data.as_bytes())?
+            .into_iter()
+            .map(|e| e.path)
+            .collect();
+        assert_eq!(
+            paths,
+            ["usr", "./x", "usr/bin", "usr/lib", "z"].map(PathBuf::from)
+        );
+        Ok(())
+    }
+
+    /// Ensures that relative paths are never merged with full paths.
+    #[test]
+    fn relative_not_merged() -> TestResult {
+        let data = "#mtree\na type=file\n./a type=file uid=3\na type=file\n";
+        let entries = parse(data.as_bytes())?;
+        assert_eq!(entries.len(), 3);
+        assert_eq!((entries[0].uid, entries[1].uid), (0, 3));
+        Ok(())
