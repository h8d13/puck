+/// Recognizes the end of a list of values as libalpm sees it, without consuming anything.
+///
+/// libalpm splits lines at `\n` only, so a blank line is a single `\n`.
+fn end_of_block<'a>(input: &mut Input<'a>) -> PResult<'a, ()> {
+    peek(alt(("\n".void(), eof.void()))).parse_next(input)
+}
+
+/// Recognizes the end of a list of values according to `end`, without consuming anything.
+fn end_of_list<'a>(end: ListEnd, input: &mut Input<'a>) -> PResult<'a, ()> {
+    match end {
+        ListEnd::Spec => end_of_values(input),
+        ListEnd::Libalpm => end_of_block(input),
+    }
+}
