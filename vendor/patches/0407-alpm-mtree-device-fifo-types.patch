+    /// Ensures that all file types of libarchive are read.
+    #[test]
+    fn file_types() -> TestResult {
+        let data = "#mtree\n/set uid=0\n./b type=block\n./c type=char\n./d type=dir\n\
+            ./p type=fifo\n./f type=file\n./l type=link\n";
+        let types: Vec<EntryType> = parse(data.as_bytes())?
+            .into_iter()
+            .map(|entry| entry.entry_type)
+            .collect();
+        assert_eq!(
+            types,
+            [
+                EntryType::Block,
+                EntryType::Char,
+                EntryType::Dir,
+                EntryType::Fifo,
+                EntryType::File,
+                EntryType::Link
+            ]
+        );
+        Ok(())
+    }
