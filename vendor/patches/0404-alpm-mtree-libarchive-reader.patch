+#[cfg(test)]
+mod tests {
+    use rstest::rstest;
+    use testresult::TestResult;
+
+    use super::*;
+
+    const SHA256: &str = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
+
+    /// Returns ALPM-MTREE data with a `/set` line for files and `body`.
+    fn mtree(body: &str) -> String {
+        format!("#mtree\n/set type=file uid=0 gid=0 mode=644\n{body}")
+    }
+
+    /// Returns a file line for `path`.
+    fn file(path: &str) -> String {
+        format!("{path} time=1.0 size=0 sha256digest={SHA256}\n")
+    }
+
+    /// Ensures that entries are returned in file order.
+    #[test]
+    fn file_order() -> TestResult {
+        let data = mtree(&[file("./b"), file("./a-b"), file("./a/b")].concat());
+        let paths: Vec<PathBuf> = parse(data.as_bytes())?
+            .into_iter()
+            .map(|e| e.path)
+            .collect();
+        assert_eq!(paths, ["./b", "./a-b", "./a/b"].map(PathBuf::from));
+        Ok(())
+    }
+
+    /// Ensures that keywords are read the way libarchive reads them.
