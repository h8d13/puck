+    #[case::mode_one_digit("mode=0", 0, 0, 0, Some((1, 0)))]
+    #[case::mode_two_digits("mode=44", 0o44, 0, 0, Some((1, 0)))]
+    #[case::mode_file_type("mode=0100644", 0o644, 0, 0, Some((1, 0)))]
+    #[case::size_sign("size=+5", 0o644, 0, 0, Some((1, 0)))]
+    #[case::size_negative("size=-5", 0o644, 0, 0, Some((1, 0)))]
+    #[case::size_junk("size=12x", 0o644, 12, 0, Some((1, 0)))]
+    #[case::uid_past_u32("uid=4294967296", 0o644, 0, 4294967296, Some((1, 0)))]
+    #[case::uid_negative("uid=-1", 0o644, 0, 0, Some((1, 0)))]
+    #[case::integer_time("time=7", 0o644, 0, 0, Some((7, 0)))]
+    #[case::negative_time("time=-5.3", 0o644, 0, 0, Some((-5, 3)))]
+    #[case::nanoseconds("time=1.9999999999", 0o644, 0, 0, Some((1, 999_999_999)))]
+    #[case::time_past_i64("time=99999999999999999999.1", 0o644, 0, 0, Some((i64::MAX, 0)))]
+    fn keyword_values(
+        #[case] keyword: &str,
+        #[case] mode: u32,
+        #[case] size: i64,
+        #[case] uid: i64,
+        #[case] time: Option<(i64, u32)>,
+    ) -> TestResult {
+        let data = mtree(&format!(
+            "./a time=1.0 size=0 sha256digest={SHA256} {keyword}\n"
+        ));
+        let entry = &parse(data.as_bytes())?[0];
+        assert_eq!(
+            (entry.mode, entry.size, entry.uid, entry.time),
+            (mode, size, uid, time)
+        );
+        Ok(())
+    }
+
+    /// Ensures that keywords of the same value are read in libarchive's order.
+    #[test]
+    fn keyword_order() -> TestResult {
+        let other = "0".repeat(64);
+        let data = format!(
+            "#mtree\n/set type=file uid=0 gid=0 mode=644 time=1.0 size=0 sha256={SHA256}\n\
+            /set sha256digest={other}\n./a\n\
+            ./b sha256={other} sha256digest={SHA256} sha256={other}\n"
+        );
+        let entries = parse(data.as_bytes())?;
+        assert_eq!(
+            entries[0].sha256_digest,
+            Sha256Checksum::from_str(&other).ok()
+        );
+        assert_eq!(
+            entries[1].sha256_digest,
+            Sha256Checksum::from_str(SHA256).ok()
+        );
+        Ok(())
+    }
+
+    /// Ensures that `/set` takes any keyword, and `/unset all` removes all of them.
+    #[test]
+    fn set_and_unset() -> TestResult {
+        let data = format!(
+            "#mtree\n/set type=dir uid=0 gid=0 mode=755 time=2.0\n./a\n\
+            /unset all\n./b type=dir uid=0 gid=0 mode=755 time=3.0\n"
+        );
+        let entries = parse(data.as_bytes())?;
+        assert_eq!(entries[0].time, Some((2, 0)));
+        assert_eq!(entries[1].time, Some((3, 0)));
+        Ok(())
+    }
+
+    /// Ensures that escape sequences are decoded the way libarchive decodes them.
+    #[rstest]
+    #[case::hash(r"./a\#b", b"./a\\#b")]
+    #[case::backslash(r"./a\\b", b"./a\\b")]
+    #[case::space(r"./a\sb", b"./a b")]
+    #[case::octal(r"./a\040b", b"./a b")]
+    #[case::non_utf8(r"./a\377", b"./a\xff")]
+    #[case::unknown(r"./a\xb\400", b"./a\\xb\\400")]
+    #[case::nul(r"./a\0b", b"./a")]
+    fn escapes(#[case] path: &str, #[case] expected: &[u8]) -> TestResult {
+        let entry = &parse(mtree(&file(path)).as_bytes())?[0];
+        assert_eq!(
+            entry.path,
+            PathBuf::from(OsString::from_vec(expected.to_vec()))
+        );
+        Ok(())
+    }
+
+    /// Ensures that whitespace, continuation lines and CRLF line endings are read.
+    #[test]
+    fn line_syntax() -> TestResult {
+        let data = mtree(&format!(
+            "  ./a\ttime=1.0 size=0 \\\n sha256digest={SHA256}  \r\n\t# comment\n"
+        ));
+        assert_eq!(parse(data.as_bytes())?.len(), 1);
+        Ok(())
+    }
+
+    /// Ensures that a last line without newline is not read, like libarchive does.
+    #[test]
+    fn last_line_without_newline() -> TestResult {
+        let data = mtree(&file("./a")) + file("./b").trim_end();
+        assert_eq!(parse(data.as_bytes())?.len(), 1);
+        Ok(())
+    }
+
+    /// Ensures that lines libarchive refuses fail.
+    #[rstest]
+    #[case::non_ascii("./a\u{e9} type=dir\n")]
+    #[case::control("./a type=dir\x7f\n")]
+    #[case::unknown_command("/foo\n")]
+    #[case::set_without_space("/set\n")]
+    #[case::unset_value("/unset uid=0\n")]
+    fn refused_lines(#[case] line: &str) {
+        assert!(parse(mtree(line).as_bytes()).is_err());
+    }
+
+    /// Ensures that keywords libarchive warns about fail.
+    #[rstest]
+    #[case::unknown_keyword("foo=1")]
+    #[case::no_value("foo")]
+    #[case::unknown_type("type=fi")]
+    #[case::symbolic_mode("mode=u+x")]
+    #[case::uppercase_digest(
+        "sha256digest=E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"
+    )]
+    #[case::short_digest("md5digest=abc")]
+    #[case::device_format("device=foo,1,2")]
+    fn warned_keywords(#[case] keyword: &str) {
+        let data = mtree(&format!(
+            "./a time=1.0 size=0 sha256digest={SHA256} {keyword}\n"
+        ));
+        assert!(parse(data.as_bytes()).is_err());
+    }
+
+    /// Ensures that the data may be gzip compressed.
+    #[test]
+    fn gzip_reader() -> TestResult {
+        use std::io::Write;
+
+        use flate2::{Compression, write::GzEncoder};
+
+        let mut encoder = GzEncoder::new(Vec::new(), Compression::default());
+        encoder.write_all(mtree(&file("./a")).as_bytes())?;
+        let data = encoder.finish()?;
+        assert_eq!(from_reader(data.as_slice())?.len(), 1);
+        Ok(())
+    }
+}
