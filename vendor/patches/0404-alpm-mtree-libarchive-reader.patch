+//! Reading of ALPM-MTREE data the way libarchive reads mtree files.
+//!
+//! pacman reads the `.MTREE` file of packages and the `mtree` files of its local database with
+//! the mtree reader of libarchive (`archive_read_support_format_mtree.c`).
+//! The functions in this module follow that reader, so that the data can be seen the way
+//! pacman sees it: entries are returned in file order, with the values libarchive reads for
+//! them.
+//!
+//! In contrast to [`parse_mtree_v2`][crate::parse_mtree_v2], this is a reader for existing data
+//! and does not validate it against the [ALPM-MTREE] specification.
+//!
+//! [ALPM-MTREE]: https://alpm.archlinux.page/specifications/ALPM-MTREE.5.html
+
+use std::{
+    ffi::OsString,
+    fmt::{Display, Formatter},
+    io::{BufReader, Read},
+    os::unix::ffi::OsStringExt,
+    path::PathBuf,
+    str::FromStr,
+};
+
+use alpm_types::{Md5Checksum, Sha256Checksum};
+use fluent_i18n::t;
+
+use crate::{Error, utils::mtree_buffer_decompress};
+
+/// The maximum length of a line (including continuation lines and the newline).
+const LINE_LIMIT: usize = 65536;
+
+/// The file type bits of a file mode (`S_IFMT`).
+const S_IFMT: u32 = 0o170000;
+
+/// The file type of an [`Entry`].
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum EntryType {
+    /// A directory (`type=dir`).
+    Dir,
+    /// A regular file (`type=file`).
+    File,
+    /// A symlink (`type=link`).
+    Link,
+}
+
+/// A path of ALPM-MTREE data, as libarchive reads it.
+///
+/// Keywords that are not set leave the values libarchive uses for them.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Entry {
+    /// The path with its escape sequences decoded (e.g. `./usr/bin`).
+    pub path: PathBuf,
+    /// The file type.
+    pub entry_type: EntryType,
+    /// The user ID, `0` if not set.
+    pub uid: i64,
+    /// The group ID, `0` if not set.
+    pub gid: i64,
+    /// The permission bits of the file mode, `0` if not set.
+    pub mode: u32,
+    /// The size in bytes, `0` if not set.
+    pub size: i64,
+    /// The modification time as seconds and nanoseconds since the epoch.
+    pub time: Option<(i64, u32)>,
+    /// The target of a symlink.
+    pub link: Option<PathBuf>,
+    /// The MD-5 hash digest.
+    pub md5_digest: Option<Md5Checksum>,
+    /// The SHA-256 hash digest.
+    pub sha256_digest: Option<Sha256Checksum>,
+}
+
+impl Entry {
+    /// Creates an [`Entry`] for `path` with the defaults libarchive starts from.
+    fn new(path: Vec<u8>) -> Self {
+        Self {
+            path: PathBuf::from(OsString::from_vec(path)),
+            entry_type: EntryType::File,
+            uid: 0,
+            gid: 0,
+            mode: 0,
+            size: 0,
+            time: None,
+            link: None,
+            md5_digest: None,
+            sha256_digest: None,
+        }
+    }
+}
+
+/// A keyword libarchive reads with a warning.
+///
+/// libarchive returns the entry nevertheless, without the value of that keyword.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum Warning {
+    /// No `type` keyword is set, the entry is a file.
+    MissingType,
+    /// The value of the `type` keyword is unknown, the entry is a file.
+    UnknownType(String),
+    /// The keyword is unknown.
+    UnknownKeyword(String),
+    /// The keyword has no value.
+    NoValue(String),
+    /// The value of the `mode` keyword is not an octal number.
+    NonOctalMode(String),
+    /// The value of a digest keyword has the wrong length or is not lowercase hexadecimal.
+    BadDigest(String),
+    /// The value of a `device` or `resdevice` keyword has an unknown format.
+    BadDevice(String),
+}
+
+impl Display for Warning {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        let message = match self {
+            Self::MissingType => t!("libarchive-missing-type"),
+            Self::UnknownType(value) => t!("libarchive-unknown-type", { "value" => value }),
+            Self::UnknownKeyword(key) => t!("libarchive-unknown-keyword", { "key" => key }),
+            Self::NoValue(key) => t!("libarchive-no-value", { "key" => key }),
+            Self::NonOctalMode(value) => t!("libarchive-non-octal-mode", { "value" => value }),
+            Self::BadDigest(key) => t!("libarchive-bad-digest", { "key" => key }),
+            Self::BadDevice(value) => t!("libarchive-bad-device", { "value" => value }),
+        };
+        write!(f, "{message}")
+    }
+}
+
+/// `key=value` keywords, in the order they are set.
+///
+/// Setting a keyword replaces an earlier one with the same key.
+#[derive(Clone, Debug, Default)]
+struct Keywords(Vec<Vec<u8>>);
+
+impl Keywords {
+    /// Returns the key of a keyword: the part before the first `=`.
+    fn key(keyword: &[u8]) -> &[u8] {
+        keyword.split(|&b| b == b'=').next().unwrap_or_default()
+    }
+
+    /// Sets a keyword, replacing the one with the same key.
+    fn set(&mut self, keyword: &[u8]) {
+        self.unset(Self::key(keyword));
+        self.0.push(keyword.to_vec());
+    }
+
+    /// Removes the keyword with `key`.
+    fn unset(&mut self, key: &[u8]) {
+        self.0.retain(|keyword| Self::key(keyword) != key);
+    }
+
+    /// Returns the keywords of a path line over these `/set` keywords, in the order libarchive
+    /// reads them.
+    ///
+    /// libarchive prepends to its keyword lists: the keywords of the line come newest first,
+    /// then the `/set` keywords in the order they were set.
+    /// The order matters for keys of the same value (`sha256` and `sha256digest`), the last one
+    /// read wins.
+    fn with_line<'a>(&self, words: impl Iterator<Item = &'a [u8]>) -> Self {
+        let mut defaults = self.clone();
+        let mut own = Self::default();
+        for keyword in words {
+            defaults.unset(Self::key(keyword));
+            own.set(keyword);
+        }
+        own.0.reverse();
+        own.0.extend(defaults.0);
+        own
+    }
+}
+
+/// A path line: the path as written and the keywords that apply to it.
+#[derive(Debug)]
+struct PathLine {
+    /// The line number, counting continuation lines as one.
+    number: usize,
+    /// The path as written, with escape sequences.
+    raw: Vec<u8>,
+    /// The keywords of the line and the `/set` keywords at that line, in the order libarchive
+    /// reads them (see [`Keywords::with_line`]).
+    keywords: Keywords,
+}
+
+/// Splits a line into words: separated by spaces, tabs, carriage returns and newlines.
+fn words(line: &[u8]) -> impl Iterator<Item = &[u8]> {
+    line.split(|b| b" \t\r\n".contains(b))
+        .filter(|word| !word.is_empty())
+}
+
+/// Returns a parse error for line `number`.
+fn line_error(number: usize, reason: String) -> Error {
+    Error::Parse(t!("libarchive-line-error", {
+        "line_number" => number.to_string(),
+        "reason" => reason,
+    }))
+}
+
+/// Cuts the next line off `data` and returns it without its newline.
+///
+/// A backslash before a newline joins the next line.
+/// Returns [`None`] at the end of `data`: like libarchive, a last line without a newline is not
+/// read, and a NUL byte ends the data.
+///
+/// # Errors
+///
+/// Returns an error if the line is longer than [`LINE_LIMIT`].
+fn next_line(data: &mut &[u8], number: usize) -> Result<Option<Vec<u8>>, Error> {
+    let input = *data;
+    let mut line = Vec::new();
+    let mut i = 0;
+    loop {
+        if i + 1 > LINE_LIMIT {
+            return Err(line_error(number, t!("libarchive-line-too-long")));
+        }
+        match input.get(i) {
+            None | Some(0) => return Ok(None),
+            Some(b'\n') => {
+                *data = &input[i + 1..];
+                return Ok(Some(line));
+            }
+            Some(b'\\') => match input.get(i + 1) {
+                Some(b'\n') => i += 2,
+                // An escaped byte never ends the line.
+                Some(&next) if next != 0 => {
+                    line.extend_from_slice(&[b'\\', next]);
+                    i += 2;
+                }
+                _ => {
+                    line.push(b'\\');
+                    i += 1;
+                }
+            },
+            Some(&byte) => {
+                line.push(byte);
+                i += 1;
+            }
+        }
+    }
+}
+
+/// Reads the lines of `data` and returns the path lines with their keywords.
+///
+/// Handles comments, empty lines, `/set` and `/unset`.
+///
+/// # Errors
+///
+/// Returns an error for the lines libarchive refuses: non-printable bytes, unknown `/` commands
+/// and `/unset` with a value.
+fn path_lines(mut data: &[u8]) -> Result<Vec<PathLine>, Error> {
+    let mut defaults = Keywords::default();
+    let mut paths = Vec::new();
+    let mut number = 0;
+
+    while let Some(line) = next_line(&mut data, number + 1)? {
+        number += 1;
+        let start = line
+            .iter()
+            .position(|&b| b != b' ' && b != b'\t')
+            .unwrap_or(line.len());
+        let line = &line[start..];
+        if matches!(line.first(), None | Some(b'#' | b'\r')) {
+            continue;
+        }
+
+        // Only printable ASCII and tabs, a carriage return may end the line.
+        let text = line.strip_suffix(b"\r").unwrap_or(line);
+        if !text
+            .iter()
+            .all(|&b| b == b'\t' || (b' '..=b'~').contains(&b))
+        {
+            return Err(line_error(number, t!("libarchive-non-printable")));
+        }
+
+        if line[0] != b'/' {
+            let mut words = words(line);
+            let raw = words.next().unwrap_or_default().to_vec();
+            let keywords = defaults.with_line(words);
+            paths.push(PathLine {
+                number,
+                raw,
+                keywords,
+            });
+        } else if let Some(rest) = line.strip_prefix(b"/set") {
+            if !matches!(rest.first(), Some(b' ' | b'\t')) {
+                return Err(line_error(number, t!("libarchive-unknown-command")));
+            }
+            for keyword in words(rest) {
+                defaults.set(keyword);
+            }
+        } else if let Some(rest) = line.strip_prefix(b"/unset") {
+            if !matches!(rest.first(), Some(b' ' | b'\t')) {
+                return Err(line_error(number, t!("libarchive-unknown-command")));
+            }
+            if rest.contains(&b'=') {
+                return Err(line_error(number, t!("libarchive-unset-value")));
+            }
+            for key in words(rest) {
+                if key == b"all" {
+                    defaults = Keywords::default();
+                } else {
+                    defaults.unset(key);
+                }
+            }
+        } else {
+            return Err(line_error(number, t!("libarchive-unknown-command")));
+        }
+    }
+
+    Ok(paths)
+}
+
+/// Decodes the escape sequences of a path or link target like libarchive's `parse_escapes`.
+///
+/// Knows `\\`, `\a`, `\b`, `\f`, `\n`, `\r`, `\s`, `\t`, `\v`, octal triplets from `\000` to
+/// `\377` and `\0` not followed by an octal digit. Other backslashes are kept.
+/// The result ends before the first NUL byte, as libarchive handles it as a C string.
+fn decode(raw: &[u8]) -> Vec<u8> {
+    let is_octal = |b: u8| (b'0'..=b'7').contains(&b);
+    let mut out = Vec::with_capacity(raw.len());
+    let mut i = 0;
+    while i < raw.len() {
+        let mut byte = raw[i];
+        i += 1;
+        if byte == b'\\' {
+            let at = |k: usize| raw.get(i + k).copied().unwrap_or(0);
+            let simple = match at(0) {
+                b'\\' => Some(b'\\'),
+                b'a' => Some(0x07),
+                b'b' => Some(0x08),
+                b'f' => Some(0x0c),
+                b'n' => Some(b'\n'),
+                b'r' => Some(b'\r'),
+                b's' => Some(b' '),
+                b't' => Some(b'\t'),
+                b'v' => Some(0x0b),
+                b'0' if !is_octal(at(1)) => Some(0),
+                _ => None,
+            };
+            if let Some(simple) = simple {
+                byte = simple;
+                i += 1;
+            } else if (b'0'..=b'3').contains(&at(0)) && is_octal(at(1)) && is_octal(at(2)) {
+                byte = ((at(0) - b'0') << 6) | ((at(1) - b'0') << 3) | (at(2) - b'0');
+                i += 3;
+            }
+        }
+        out.push(byte);
+    }
+    if let Some(end) = out.iter().position(|&b| b == 0) {
+        out.truncate(end);
+    }
+    out
+}
+
+/// Reads a number like libarchive's `mtree_atol`.
+///
+/// An optional `-` and the digits of `base` up to the first other byte, saturated at the bounds
+/// of [`i64`].
+/// Returns the number and the count of bytes read.
+fn atol(value: &[u8], base: u32) -> (i64, usize) {
+    let negative = value.first() == Some(&b'-');
+    let mut i = usize::from(negative);
+    let mut number: i64 = 0;
+    while let Some(digit) = value
+        .get(i)
+        .and_then(|&b| char::from(b).to_digit(16))
+        .filter(|&digit| digit < base)
+    {
+        let next = number.checked_mul(base.into()).and_then(|n| {
+            if negative {
+                n.checked_sub(digit.into())
+            } else {
+                n.checked_add(digit.into())
+            }
+        });
+        let Some(next) = next else {
+            return (if negative { i64::MIN } else { i64::MAX }, i);
+        };
+        number = next;
+        i += 1;
+    }
+    (number, i)
+}
+
+/// Reads a hash digest of `len` bytes like libarchive: exactly `2 * len` lowercase hexadecimal
+/// digits.
+fn digest(key: &[u8], value: &[u8], len: usize) -> Result<String, Warning> {
+    let lower_hex = |b: &u8| b.is_ascii_digit() || (b'a'..=b'f').contains(b);
+    if value.len() != 2 * len || !value.iter().all(lower_hex) {
+        return Err(Warning::BadDigest(lossy(key)));
+    }
+    Ok(lossy(value))
+}
+
+/// The formats libarchive knows for `device` values with major and minor numbers.
+const DEVICE_FORMATS: [&[u8]; 16] = [
+    b"386bsd", b"4bsd", b"bsdos", b"freebsd", b"hpux", b"isc", b"linux", b"native", b"netbsd",
+    b"osf1", b"sco", b"solaris", b"sunos", b"svr3", b"svr4", b"ultrix",
+];
+
+/// Checks a `device` or `resdevice` value: a number or `format,major,minor[,...]`.
+fn device(value: &[u8]) -> Result<(), Warning> {
+    let mut fields = value.split(|&b| b == b',');
+    let format = fields.next().unwrap_or_default();
+    let numbers: Vec<&[u8]> = fields.collect();
+    if numbers.is_empty() {
+        return Ok(());
+    }
+    if !DEVICE_FORMATS.contains(&format)
+        || numbers.len() > 3
+        || numbers.len() < 2
+        || numbers.iter().any(|n| n.is_empty())
+    {
+        return Err(Warning::BadDevice(lossy(value)));
+    }
+    Ok(())
+}
+
+/// Returns `bytes` as a [`String`], with invalid UTF-8 replaced.
+fn lossy(bytes: &[u8]) -> String {
+    String::from_utf8_lossy(bytes).into_owned()
+}
+
+/// The keywords that were read for an [`Entry`], beyond the values it carries.
+#[derive(Debug, Default)]
+struct Seen {
+    entry_type: bool,
+    uid: bool,
+    gid: bool,
+    mode: bool,
+    size: bool,
+}
+
+/// Reads one keyword into `entry` like libarchive's `parse_keyword`.
+fn read_keyword(entry: &mut Entry, seen: &mut Seen, keyword: &[u8]) -> Result<(), Warning> {
+    if matches!(keyword, b"nochange" | b"optional" | b"ignore") {
+        return Ok(());
+    }
+    let Some(eq) = keyword.iter().position(|&b| b == b'=') else {
+        return Err(Warning::NoValue(lossy(keyword)));
+    };
+    let (key, value) = (&keyword[..eq], &keyword[eq + 1..]);
+
+    match key {
+        b"cksum" | b"content" | b"contents" | b"flags" | b"gname" | b"inode" | b"nlink"
+        | b"tags" | b"uname" => {}
+        b"device" | b"resdevice" => device(value)?,
+        b"gid" => {
+            seen.gid = true;
+            entry.gid = atol(value, 10).0.max(0);
+        }
+        b"uid" => {
+            seen.uid = true;
+            entry.uid = atol(value, 10).0.max(0);
+        }
+        b"link" => {
+            entry.link = Some(PathBuf::from(OsString::from_vec(decode(value))));
+        }
+        b"md5" | b"md5digest" => {
+            let hex = digest(key, value, 16)?;
+            entry.md5_digest = Md5Checksum::from_str(&hex).ok();
+        }
+        b"sha256" | b"sha256digest" => {
+            let hex = digest(key, value, 32)?;
+            entry.sha256_digest = Sha256Checksum::from_str(&hex).ok();
+        }
+        b"rmd160" | b"rmd160digest" | b"sha1" | b"sha1digest" => {
+            digest(key, value, 20)?;
+        }
+        b"sha384" | b"sha384digest" => {
+            digest(key, value, 48)?;
+        }
+        b"sha512" | b"sha512digest" => {
+            digest(key, value, 64)?;
+        }
+        b"mode" => {
+            if !matches!(value.first(), Some(b'0'..=b'7')) {
+                return Err(Warning::NonOctalMode(lossy(value)));
+            }
+            seen.mode = true;
+            // mode_t is 32 bits wide, the file type comes from the type keyword.
+            entry.mode = atol(value, 8).0 as u32 & !S_IFMT;
+        }
+        b"size" => {
+            seen.size = true;
+            entry.size = atol(value, 10).0.max(0);
+        }
+        b"time" => {
+            // Seconds, optionally followed by a dot and nanoseconds.
+            let (seconds, read) = atol(value, 10);
+            let mut nanoseconds = 0;
+            if value.get(read) == Some(&b'.') {
+                nanoseconds = atol(&value[read + 1..], 10).0.clamp(0, 999_999_999) as u32;
+            }
+            entry.time = Some((seconds, nanoseconds));
+        }
+        b"type" => {
+            let entry_type = match value {
+                b"dir" => Some(EntryType::Dir),
+                b"file" => Some(EntryType::File),
+                b"link" => Some(EntryType::Link),
+                _ => None,
+            };
+            // An unknown type is read as a file.
+            entry.entry_type = entry_type.unwrap_or(EntryType::File);
+            if entry_type.is_none() {
+                return Err(Warning::UnknownType(lossy(value)));
+            }
+            seen.entry_type = true;
+        }
+        _ => return Err(Warning::UnknownKeyword(lossy(key))),
+    }
+
+    Ok(())
+}
+
+/// Reads the keywords of `line` into `entry` like libarchive's `parse_line`.
+///
+/// # Errors
+///
+/// Returns an error if libarchive warns about one of the keywords or the type is not set.
+fn read_line(entry: &mut Entry, seen: &mut Seen, line: &PathLine) -> Result<(), Error> {
+    for keyword in &line.keywords.0 {
+        if let Err(warning) = read_keyword(entry, seen, keyword) {
+            return Err(line_error(line.number, warning.to_string()));
+        }
+    }
+    if !seen.entry_type {
+        return Err(line_error(line.number, Warning::MissingType.to_string()));
+    }
+    Ok(())
+}
+
+/// Ensures that the keywords [ALPM-MTREE] requires for the type of `entry` are set.
+///
+/// [ALPM-MTREE]: https://alpm.archlinux.page/specifications/ALPM-MTREE.5.html
+fn ensure_required(entry: &Entry, seen: &Seen, line: &PathLine) -> Result<(), Error> {
+    let mut missing = Vec::new();
+    for (name, set) in [
+        ("uid", seen.uid),
+        ("gid", seen.gid),
+        ("mode", seen.mode),
+        ("time", entry.time.is_some()),
+    ] {
+        if !set {
+            missing.push(name);
+        }
+    }
+    match entry.entry_type {
+        EntryType::File => {
+            if !seen.size {
+                missing.push("size");
+            }
+            if entry.sha256_digest.is_none() {
+                missing.push("sha256digest");
+            }
+        }
+        EntryType::Link => {
+            if entry.link.is_none() {
+                missing.push("link");
+            }
+        }
+        EntryType::Dir => {}
+    }
+    if let Some(name) = missing.first() {
+        return Err(line_error(
+            line.number,
+            t!("libarchive-missing-keyword", { "key" => *name }),
+        ));
+    }
+    Ok(())
+}
+
+/// Parses ALPM-MTREE data like libarchive's mtree reader.
+///
+/// Returns the entries in the order of their lines.
+///
+/// # Examples
+///
+/// ```
+/// use alpm_mtree::libarchive::{EntryType, parse};
+///
+/// # fn main() -> Result<(), alpm_mtree::Error> {
+/// let data = br#"#mtree
+/// /set type=file uid=0 gid=0 mode=644
+/// ./b time=1700000000.0 size=0 sha256digest=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
+/// ./a type=dir time=1700000000.0 mode=755
+/// "#;
+/// let entries = parse(data)?;
+/// assert_eq!(entries[0].path.as_os_str(), "./b");
+/// assert_eq!(entries[1].entry_type, EntryType::Dir);
+/// assert_eq!(entries[1].mode, 0o755);
+/// # Ok(())
+/// # }
+/// ```
+///
+/// # Errors
+///
+/// Returns an error if
+/// - a line cannot be parsed,
+/// - libarchive warns about a keyword of a path,
+/// - a path is not relative to the package (`./`),
+/// - or a path misses a keyword [ALPM-MTREE] requires for its type.
+///
+/// [ALPM-MTREE]: https://alpm.archlinux.page/specifications/ALPM-MTREE.5.html
+pub fn parse(data: &[u8]) -> Result<Vec<Entry>, Error> {
+    let mut entries = Vec::new();
+
+    for line in path_lines(data)? {
+        // A path with a `/` (or `.`) is a full path, all others are relative to the
+        // directory of the previous lines.
+        if line.raw != b"." && !line.raw.contains(&b'/') {
+            return Err(line_error(line.number, t!("libarchive-relative-path")));
+        }
+        let mut entry = Entry::new(decode(&line.raw));
+        let mut seen = Seen::default();
+        read_line(&mut entry, &mut seen, &line)?;
+        ensure_required(&entry, &seen, &line)?;
+        entries.push(entry);
+    }
+
+    Ok(entries)
+}
+
+/// Reads ALPM-MTREE data from `reader` and parses it like libarchive's mtree reader.
+///
+/// The data may be gzip compressed.
+/// Delegates to [`parse`].
+///
+/// # Errors
+///
+/// Returns an error if `reader` cannot be read, the gzip compressed data is invalid or [`parse`]
+/// fails.
+pub fn from_reader(reader: impl Read) -> Result<Vec<Entry>, Error> {
+    let mut buffer = Vec::new();
+    BufReader::new(reader)
+        .read_to_end(&mut buffer)
+        .map_err(|source| Error::Io {
+            context: t!("error-io-read-mtree-data"),
+            source,
+        })?;
+    parse(&mtree_buffer_decompress(buffer)?)
+}
