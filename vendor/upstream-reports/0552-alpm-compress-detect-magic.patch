+    #[case::empty(b"")]
+    #[case::one_byte(&[0x1f])]
+    #[case::partial_xz(&[0xfd, b'7', b'z'])]
+    fn test_from_magic_short(#[case] magic: &[u8]) {
+        assert_eq!(
+            DecompressionSettings::from_magic(magic),
+            DecompressionSettings::None
+        );
+    }
